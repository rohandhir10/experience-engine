# Copy to .env.local for local dev; set the same values in Vercel's
# project settings for deploys. Nothing here is real - fill it in.

# Where the Python engine API lives (server/main.py). Railway's public
# domain in production; the local uvicorn port in dev.
AURA_ENGINE_API_URL=http://localhost:8000

# --- Auth.js (web/auth.ts) ------------------------------------------
# Any long random string. Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth client, from console.cloud.google.com -> APIs & Services
# -> Credentials -> OAuth client ID (type: Web application).
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<your-domain>/api/auth/callback/google   (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared secret proving a request to the engine came from THIS server
# (which verified the Google sign-in) rather than from a browser. Must
# match AURA_INTERNAL_API_SECRET on the Railway service exactly. Any
# long random string. Without it, accounts are off: sign-in still works
# but no history is recorded (server/main.py::_authed_user_id).
AURA_INTERNAL_API_SECRET=
