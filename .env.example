# Python engine API (server/main.py). Copy to .env for local dev; set
# these as variables on the Railway service in production.

# LLM provider credentials - only the active provider's key is needed
# (engine/config.py::PROVIDER, defaults to openai).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Postgres. Railway's Postgres plugin provides this; without it the
# engine still runs but falls back to file-based caching and disables
# accounts, job persistence, and cross-user cache reuse.
DATABASE_URL=

# Shared secret for the account endpoints - must match
# CASTIA_INTERNAL_API_SECRET in the Next.js app exactly. Unset means
# accounts are off (adapt requests still work, anonymously).
CASTIA_INTERNAL_API_SECRET=

# Comma-separated origins allowed to call this API (the Vercel domain).
CASTIA_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional tuning (all have working defaults) ---------------------
# CASTIA_DAILY_LIMIT=10             # per-IP new songs per day; 0 disables
# CASTIA_API_DAILY_LIMIT=1000       # per-API-key requests/day for /v1/*; 0 disables
# CASTIA_MAX_CONCURRENT_RUNS=4      # simultaneous engine runs
# CASTIA_DB_POOL_SIZE=10
# CASTIA_DB_MAX_OVERFLOW=10
# CASTIA_MAX_INPUT_CHARS=8000
