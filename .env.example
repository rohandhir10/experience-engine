# Python engine API (server/main.py). Copy to .env for local dev; set
# these as variables on the Railway service in production.

# LLM provider credentials - only the active provider's key is needed
# (engine/config.py::PROVIDER, defaults to openai).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Postgres. Railway's Postgres plugin provides this; without it the
# engine still runs but falls back to file-based caching and disables
# accounts, job persistence, and cross-user cache reuse.
DATABASE_URL=

# Shared secret for the account endpoints - must match
# CASTIA_INTERNAL_API_SECRET in the Next.js app exactly. Unset means
# accounts are off (adapt requests still work, anonymously).
CASTIA_INTERNAL_API_SECRET=

# Comma-separated origins allowed to call this API (the Vercel domain).
CASTIA_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional tuning (all have working defaults) ---------------------
# CASTIA_DAILY_LIMIT=10             # per-IP new songs per day; 0 disables
# CASTIA_API_DAILY_LIMIT=1000       # per-API-key requests/day for /v1/*; 0 disables
# CASTIA_MAX_CONCURRENT_RUNS=4      # simultaneous engine runs
# CASTIA_DB_POOL_SIZE=10
# CASTIA_DB_MAX_OVERFLOW=10
# CASTIA_MAX_INPUT_CHARS=8000

# Optional: a vision-capable model reading comic panels alongside Cloud
# Vision's OCR (engine/comics_vision.py). Off by default - it adds a real
# per-panel model call with real cost, and the OCR path works without it.
# Set to 1 to enable; it reads stylized lettering better than OCR, tells
# dialogue from sound effects, and can attribute a speaker.
CASTIA_VISION_READING=0
# Must be a model that accepts image input. Kept separate from the text
# pipeline's model so pinning that one to something cheap can't silently
# break panel reading.
# CASTIA_VISION_MODEL=gpt-4o

# Optional: a text-region DETECTOR running as its own service
# (comic-text-detector, a YOLO bubble model). When set, the comics OCR
# endpoint switches to the two-step read - detect boxes first, then run
# the vision pass and the recogniser concurrently against those boxes.
# Unset means the original single-step Cloud Vision path.
# CASTIA_TEXT_DETECTOR_URL=http://detector.internal/detect

# Optional: manga-ocr, a JAPANESE-ONLY comic text recogniser. Routed to
# per script - every other language keeps the general recogniser. Prefer
# the URL form: manga-ocr needs torch + transformers, which would add
# gigabytes to this project's slim API image.
# CASTIA_MANGA_OCR_URL=http://manga-ocr.internal/read
CASTIA_MANGA_OCR=0

# Optional: a LaMa/IOPaint service that reconstructs artwork behind
# erased comic text. Unset means the local OpenCV Telea fill, which is
# fine on plain speech bubbles and visibly smeary on text over drawn
# artwork. A failure here degrades redraw quality (it falls back to
# OpenCV), never the request.
# CASTIA_INPAINT_URL=http://lama.internal/inpaint
# CASTIA_INPAINT_TIMEOUT=60
